# --- Database (Postgres) ---
POSTGRES_DB=assignment_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- MongoDB (activity/audit log — wired in a later pass) ---
MONGO_USER=mongo
MONGO_PASSWORD=mongo
MONGO_PORT=27017

# --- Redis (read cache — wired in a later pass) ---
REDIS_PORT=6379

# --- Backend API ---
# ASP.NET Core doesn't read .env files natively. Copy
# backend/src/Api/appsettings.Development.json.example to
# appsettings.Development.json and mirror these values there.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_system;Username=postgres;Password=postgres
Jwt__Secret=replace-with-a-long-random-string-min-32-chars
Jwt__Issuer=assignment-system-api
Jwt__Audience=assignment-system-client
Jwt__ExpiryMinutes=120

# --- Frontend (frontend/.env.local, later pass) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
