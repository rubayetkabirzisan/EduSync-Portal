# --- Database (Postgres) ---
POSTGRES_DB=assignment_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Backend API ---
# ASP.NET Core doesn't read .env files natively. The backend uses
# the DotNetEnv package to load a .env file placed in the project root.
# Copy this file as `.env` and update the values for your environment.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_system;Username=postgres;Password=postgres
Jwt__Secret=replace-with-a-long-random-string-min-32-chars
Jwt__Issuer=assignment-system-api
Jwt__Audience=assignment-system-client
Jwt__ExpiryMinutes=120

# --- Email (Resend) ---
Resend__ApiKey=re_your_resend_api_key_here

# --- Chatbot (Django service URL) ---
# Set this to your Python chatbot's Render URL once deployed
ChatbotApiBaseUrl=http://localhost:8000/api/

# --- CORS (comma-separated origins for Render env var) ---
# On Render, set each as: Cors__AllowedOrigins__0, Cors__AllowedOrigins__1, etc.
Cors__AllowedOrigins__0=https://your-app.vercel.app

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5080/api
